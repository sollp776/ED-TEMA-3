<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.solsystems.menureursividad.controller.QueueController"
      alignment="CENTER"
      spacing="15"
      prefWidth="600"
      prefHeight="450">
    <Label text="Queue"
           style="-fx-font-size: 25px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtData"
               promptText="Enter data"
               prefWidth="300"/>

    <HBox spacing="10"
          alignment="CENTER">

        <Button text="Add"
                onAction="#onAdd"/>

        <Button text="Remove"
                onAction="#onRemove"/>
        <Button text="Clear"
                onAction="#onClear"/>

    </HBox>

    <TextArea fx:id="txtArea"
              editable="false"
              prefWidth="450"
              prefHeight="250"/>

    <Button text="Back to Menu"
            onAction="#backToMenu"
            prefWidth="150"
            prefHeight="35"/>

</VBox>
