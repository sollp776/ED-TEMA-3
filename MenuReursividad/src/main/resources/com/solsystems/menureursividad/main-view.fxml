<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.solsystems.menureursividad.MainController"
      alignment="CENTER"
      spacing="20"
      prefWidth="800"
      prefHeight="600">

    <Label text="Data Structures and Recursion"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Button text="List"
            onAction="#openList"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Stack"
            onAction="#openStack"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Queue"
            onAction="#openQueue"
            prefWidth="250"
            prefHeight="45"/>

    <Button text="Recursion"
            onAction="#openRecursion"
            prefWidth="250"
            prefHeight="45"/>

</VBox>
